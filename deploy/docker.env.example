# Copy to .env and replace both secrets before docker compose up -d --build.
FOXPROFILE_LANG=vi
FOXPROFILE_MODE=desktop
FOXPROFILE_API_HOST=0.0.0.0
FOXPROFILE_API_PORT=8000
FOXPROFILE_API_TOKEN=replace-with-a-random-token-at-least-24-characters
FOXPROFILE_HEADLESS=false
FOXPROFILE_RESTORE_TABS=true
FOXPROFILE_LOG_LEVEL=INFO
FOXPROFILE_PROXY_TIMEOUT=15
FOXPROFILE_LAUNCH_TIMEOUT=120
FOXPROFILE_PROFILES_FILE=/data/profiles.json
FOXPROFILE_DATA_DIR=/data/profiles
FOXPROFILE_LOG_DIR=/data/logs
FOXPROFILE_BIND_IP=127.0.0.1
FOXPROFILE_HTTP_PORT=8000
FOXPROFILE_NOVNC_PORT=6080
# VNC supports exactly 8 significant characters.
FOXPROFILE_VNC_PASSWORD=changeMe
